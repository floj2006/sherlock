# Public site settings. Set the final HTTPS domain before building.
NEXT_PUBLIC_SITE_URL=https://sherlock-murino.ru
NEXT_PUBLIC_YCLIENTS_BOOKING_URL=https://n1109830.yclients.com/

# Server only: do not prefix credentials with NEXT_PUBLIC_.
YCLIENTS_COMPANY_ID=1024543
YCLIENTS_API_URL=https://api.yclients.ru/api/v1
YCLIENTS_PARTNER_TOKEN=
YCLIENTS_USER_TOKEN=
YCLIENTS_PUBLIC_WIDGET_TOKEN=
# Persistent shared disk for booking deduplication; never a public directory.
BOOKING_STATE_DIR=./.booking-state

# Yandex ID. All credentials stay on the server.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://sherlock-murino.ru/api/auth/yandex/callback
ACCOUNT_DB_PATH=./.account-data/accounts.sqlite
# Enable only behind a proxy that replaces X-Forwarded-For.
AUTH_TRUST_PROXY=0

# Optional analytics. Counters load only after visitor permission.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YM_ID=
